# Copy this file to .env and fill in your values
# Never commit .env to git

# Your Gmail address (fortechzpvt@gmail.com)
GMAIL_USER=fortechzpvt@gmail.com

# Gmail App Password (NOT your normal Gmail password)
# How to get one:
#   1. Go to myaccount.google.com
#   2. Security → 2-Step Verification (must be ON)
#   3. Security → App passwords
#   4. Select app: Mail, device: Other → name it "Fortechz"
#   5. Copy the 16-character password here (no spaces)
GMAIL_APP_PASSWORD=your_16_char_app_password_here

# Port (optional, defaults to 3001)
PORT=3001
